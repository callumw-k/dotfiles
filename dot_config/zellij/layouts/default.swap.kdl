tab_template name="ui" {
  children 
  pane size=1 borderless=true {
       plugin location="zellij:compact-bar"
  }
}

swap_tiled_layout name="stacked" {
  ui {
    pane stacked=true {
      children;
    }
  }
}

swap_tiled_layout name="vertical" {
    // 2 columns, 1 pane each
    ui max_panes=3 {
        pane split_direction="vertical" {
            pane
            pane { children; }
        }
    }
    // 2 columns, 2 panes each
    ui max_panes=5 {
        pane split_direction="vertical" {
            pane { children; }
            pane { pane; pane; }
        }
    }
    // 2 columns, 3 panes each
    ui max_panes=7 {
        pane split_direction="vertical" {
            pane { children; }
            pane { pane; pane; pane; }
        }
    }
    // 3 columns, 3 panes each
    ui max_panes=10 {
        pane split_direction="vertical" {
            pane { children; }
            pane { pane; pane; pane; }
            pane { pane; pane; pane; }
        }
    }
    // 3 columns, 4 panes each
    ui max_panes=13 {
        pane split_direction="vertical" {
            pane { children; }
            pane { pane; pane; pane; pane; }
            pane { pane; pane; pane; pane; }
        }
    }
    // catch-all: primary pane + stacked overflow
    ui split_direction="vertical" {
        pane
        pane stacked=true { children; }
    }
}

swap_tiled_layout name="vertical-stacked" {
    ui max_panes=2  split_direction="vertical" {
        pane
        pane { children; }
    }
    ui split_direction="vertical" {
        pane 
        pane stacked=true { children; }
    }
}


swap_tiled_layout name="horizontal" {
    ui max_panes=2 {
        pane
        pane
    }
    // 2 rows, second row 2 panes
    ui max_panes=4 {
        pane {
            pane split_direction="vertical" { children; }
            pane split_direction="vertical" { pane; pane; }
        }
    }
    ui max_panes=7 {
        pane {
            pane split_direction="vertical" { children; }
            pane split_direction="vertical" { pane; pane; pane; pane; }
        }
    }
    // 3 rows, second row 4 panes, third row 2 panes
    ui max_panes=9 {
        pane {
            pane split_direction="vertical" { children; }
            pane split_direction="vertical" { pane; pane; pane; pane; }
            pane split_direction="vertical" { pane; pane; }
        }
    }
    ui max_panes=11 {
        pane {
            pane split_direction="vertical" { children; }
            pane split_direction="vertical" { pane; pane; pane; pane; }
            pane split_direction="vertical" { pane; pane; pane; pane; }
        }
    }
    // catch-all: primary pane + stacked overflow
    ui split_direction="horizontal" {
        pane
        pane stacked=true { children; }
    }
}

swap_tiled_layout name="horizontal-stacked" {
    ui max_panes=2 split_direction="horizontal" {
        pane
        pane { children; }
    }
    ui split_direction="horizontal" {
        pane
        pane stacked=true { children; }
    }
}

swap_floating_layout name="spread" {
    floating_panes max_panes=1 {
        pane {y "25%"; x "25%"; }
    }
    floating_panes max_panes=2 {
        pane { x "1%"; y "25%"; width "48%"; }
        pane { x "50%"; y "25%"; width "48%"; }
    }
    floating_panes max_panes=3 {
        pane { y "55%"; width "50%"; height "48%"; }
        pane { x "1%"; y "1%"; width "48%"; }
        pane { x "50%"; y "1%"; width "48%"; }
    }
    floating_panes max_panes=4 {
       pane { x "1%"; y "55%"; width "48%"; height "48%"; }
       pane { x "50%"; y "55%"; width "48%"; height "48%"; }
       pane { x "1%"; y "1%"; width "48%"; height "48%"; }
       pane { x "50%"; y "1%"; width "48%"; height "48%"; }
   }
}

swap_floating_layout name="staggered" {
    floating_panes
}

swap_floating_layout name="enlarged" {
    floating_panes max_panes=10 {
        pane { x "5%"; y 1; width "90%"; height "90%"; }
        pane { x "5%"; y 2; width "90%"; height "90%"; }
        pane { x "5%"; y 3; width "90%"; height "90%"; }
        pane { x "5%"; y 4; width "90%"; height "90%"; }
        pane { x "5%"; y 5; width "90%"; height "90%"; }
        pane { x "5%"; y 6; width "90%"; height "90%"; }
        pane { x "5%"; y 7; width "90%"; height "90%"; }
        pane { x "5%"; y 8; width "90%"; height "90%"; }
        pane { x "5%"; y 9; width "90%"; height "90%"; }
        pane focus=true { x 10; y 10; width "90%"; height "90%"; }
    }
}


