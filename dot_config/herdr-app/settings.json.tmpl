{
  "zoom": 1.0,
  "sounds": {
    "enabled": true
  },
  "font": "Monaspace Neon",
  "font_size": {{ if eq .chezmoi.os "darwin" }}14.0{{ else }}16.0{{ end }},
  "option_as_alt": "on",
  "font_ligatures": false,
  "ui_font": "Monaspace Neon",
  "minimum_contrast": 1.0,
  "theme": "catppuccin-macchiato",
  "repos": [
    { "path": "~/Documents/code", "children": true },
    { "path": "~/Documents/projects", "children": true },
    { "path": "~/Documents/notes/vault" },
    { "path": "~/.config/nvim" },
    { "path": "~/.local/share/chezmoi" },
    { "path": "~/.claude" }
  ]
}
