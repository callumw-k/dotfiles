#!/bin/sh
current="$(cat)"
[ -z "$current" ] && current='{}'

echo "$current" | jq '. + {
  "permissions": {
    "defaultMode": "auto"
  },
  "tui": "fullscreen",
  "statusLine": {
    "command": "bash ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "DISABLE_ERROR_REPORTING": "1"
  }
}'
