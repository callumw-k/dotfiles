#!/bin/sh
current="$(cat)"
[ -z "$current" ] && current='{}'

no_slop='{"matcher":"Write|Edit","hooks":[{"type":"command","command":"python3 \"/Users/Callum.Kane/.claude/hooks/no-slop-comments.py\""}]}'

echo "$current" | jq --argjson noSlop "$no_slop" '
  .hooks.PreToolUse = ([$noSlop] + [(.hooks.PreToolUse // [])[]
    | select(any(.hooks[]?.command; test("no-slop-comments")) | not)])
| . + {
  "permissions": {
    "defaultMode": "auto"
  },
  "tui": "fullscreen",
  "statusLine": {
    "command": "bash ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "DISABLE_ERROR_REPORTING": "1"
  }
}'
